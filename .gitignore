# Build output
/bin/
/dist/

# Runtime state. These directories hold private keys and password hashes;
# committing one would publish the CA that mints agent identities.
/nswhub-data/
/nswagent-state/
*.key
*.crt
*.pem
hub-state.json
audit.log

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# AI agent instructions, skills and planning notes stay on the maintainer's
# machine. People who run the software don't need them.
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
/.claude/
/.agents/
/.codex/
/.cursor/
/.gemini/
/.windsurf/
/.mcp.json
/local-only/
